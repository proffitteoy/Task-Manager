{
  "name": "@cw/desktop-shell",
  "version": "1.1.1",
  "private": true,
  "description": "Chromium desktop shell for Research and Development Workstation",
  "author": "Research and Development Workstation Contributors",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "electron .",
    "dev:workspace": "node scripts/dev-workspace.mjs",
    "pack": "node scripts/run-builder.mjs --dir --win",
    "dist": "node scripts/run-builder.mjs --win nsis"
  },
  "dependencies": {
    "@cw/workbench-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "dev.research-workstation.desktop",
    "productName": "Research Workstation",
    "asar": true,
    "compression": "normal",
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/after-pack.cjs",
    "npmRebuild": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/**/{__tests__,coverage,docs,example,examples,test,tests}/**",
      "!node_modules/**/*.{spec,test}.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
      "!node_modules/**/*.{map,tsbuildinfo}",
      "!node_modules/**/*.d.{cts,mts,ts}",
      "!node_modules/**/{CHANGELOG,README,readme}*",
      "!node_modules/@cw/contracts/src/**",
      "!node_modules/@cw/contracts/tsconfig.json",
      "!node_modules/@cw/contracts/**/*.d.ts",
      "!node_modules/@cw/contracts/**/*.map",
      "!node_modules/@cw/workbench-core/data/**",
      "!node_modules/@cw/workbench-core/src/**",
      "!node_modules/@cw/workbench-core/dist/__tests__/**",
      "!node_modules/@cw/workbench-core/Dockerfile",
      "!node_modules/@cw/workbench-core/tsconfig.json",
      "!node_modules/@cw/workbench-core/vitest.config.ts",
      "!node_modules/@cw/workbench-core/**/*.d.ts",
      "!node_modules/@cw/workbench-core/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "build/homepage-runtime-v4",
        "to": "app-runtime/homepage"
      },
      {
        "from": "build/tokei-runtime",
        "to": "app-runtime/tokei"
      },
      {
        "from": "build/python-runtime",
        "to": "app-runtime/python"
      },
      {
        "from": "../homepage/.next/static",
        "to": "app-runtime/homepage/apps/homepage/.next/static"
      },
      {
        "from": "../homepage/public",
        "to": "app-runtime/homepage/apps/homepage/public"
      },
      {
        "from": "../homepage/config",
        "to": "app-defaults/homepage-config",
        "filter": [
          "**/*",
          "!logs/**"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "app-assets/icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "ResearchWorkstation-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Research Workstation"
    }
  }
}
